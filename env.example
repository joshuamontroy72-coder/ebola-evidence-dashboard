# Optional API keys. The pipeline runs fully WITHOUT any of these — they only
# raise rate limits / add polite identification. Copy to ".env" for local runs,
# or add them as GitHub Actions secrets for the daily job.

# NCBI / PubMed E-utilities key (raises literature rate limits).
# Get one free at https://www.ncbi.nlm.nih.gov/account/  ▸ Settings ▸ API Key Management
NCBI_API_KEY=

# Altmetric API key (optional — the free badge endpoint works without it).
# Contact https://www.altmetric.com/ for research/API access if you need higher volume.
ALTMETRIC_API_KEY=

# A contact email used in the polite User-Agent sent to public APIs.
CONTACT_EMAIL=ebola-dashboard@phac-aspc.gc.ca
